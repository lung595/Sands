{
    "$schema": "https://github.com/AvengeMedia/DankMaterialShell/raw/refs/heads/master/PLUGINS/plugin-schema.json",
    "id": "smartTimer",
    "name": "Sands",
    "description": "A floating hourglass timer for your bar. Type “timer 20 min pasta” in the launcher, watch the sand fall, freeze it with a pause.",
    "version": "1.2.0",
    "author": "lung595",
    "license": "MIT",
    "icon": "timer",
    "type": "composite",
    "capabilities": [
        "daemon",
        "dankbar-widget",
        "launcher"
    ],
    "components": {
        "daemon": "./TimerDaemon.qml",
        "widget": "./TimerWidget.qml",
        "launcher": "./TimerLauncher.qml"
    },
    "trigger": "timer",
    "settings": "./TimerSettings.qml",
    "requires_dms": ">=1.6.0",
    "dependencies": [
        "pw-play"
    ],
    "permissions": [
        "settings_read",
        "settings_write",
        "process"
    ]
}
